# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env ke GitHub.

# ====== Wajib ======
NODE_ENV=production
PORT=3000
# Rahasia sesi login, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# ====== Database ======
# (a) docker-compose.yml (PostgreSQL di VPS): cukup isi POSTGRES_PASSWORD.
#     DATABASE_URL di bawah otomatis diganti oleh docker compose.
POSTGRES_PASSWORD=GANTI_PASSWORD_DB
# (b) docker-compose.supabase.yml / PM2 / Node langsung: isi DATABASE_URL lengkap.
#     Supabase: pakai "Session pooler" (port 5432) dan DATABASE_SSL=true.
DATABASE_URL=postgres://ekakarsa:GANTI_PASSWORD_DB@localhost:5432/ekakarsa
# Isi "true" bila database butuh SSL (Supabase, Neon, Railway, dll.)
DATABASE_SSL=false
# Maksimal koneksi database dari aplikasi (Supabase free: 3-5 sudah cukup)
DB_POOL_MAX=10

# ====== Admin pertama (hanya dipakai saat database masih kosong) ======
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ====== Aturan pelanggaran ======
# Jumlah persetujuan Pembina/Ketua/Calon Ketua yang dibutuhkan (1 = salah satu cukup, 2 = dua orang, dst.)
REQUIRED_APPROVALS=1
# Minimal jumlah saksi per laporan (tidak bisa kurang dari 2)
MIN_WITNESSES=2

# ====== Server / jaringan ======
# Nama sekolah/organisasi di kop surat
SCHOOL_NAME=OSIS Ekakarsa
# Lama sesi login (jam)
SESSION_HOURS=12
# Jumlah reverse proxy di depan aplikasi (1 untuk Nginx). "false" bila diakses langsung.
TRUST_PROXY=1
# Cookie login hanya dikirim lewat HTTPS. Biarkan true di production.
# Set false HANYA untuk uji coba sementara lewat http://IP:3000 tanpa HTTPS.
COOKIE_SECURE=true
# Alamat & port yang dibuka docker compose. 127.0.0.1 = hanya bisa diakses Nginx di VPS itu.
# Ganti APP_BIND=0.0.0.0 bila ingin uji coba langsung lewat http://IP:3000 (jangan lupa firewall).
APP_BIND=127.0.0.1
APP_PORT=3000
TZ=Asia/Jakarta
