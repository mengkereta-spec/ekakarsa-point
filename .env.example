# ====== Wajib ======
NODE_ENV=production
PORT=3000
# Koneksi PostgreSQL
DATABASE_URL=postgres://ekakarsa:GANTI_PASSWORD_DB@localhost:5432/ekakarsa
# Isi "true" bila database butuh SSL (Supabase, Neon, Railway, dll.)
DATABASE_SSL=false
# Rahasia sesi login, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# ====== Admin pertama (hanya dipakai saat database masih kosong) ======
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ====== Aturan pelanggaran ======
# Jumlah persetujuan Pembina/Ketua/Calon Ketua yang dibutuhkan (1 = salah satu cukup, 2 = dua orang, dst.)
REQUIRED_APPROVALS=1
# Minimal jumlah saksi per laporan (tidak bisa kurang dari 2)
MIN_WITNESSES=2

# ====== Lainnya ======
# Nama sekolah/organisasi di kop surat
SCHOOL_NAME=OSIS Ekakarsa
# Lama sesi login (jam)
SESSION_HOURS=12
# Jumlah reverse proxy di depan aplikasi (1 untuk Nginx/Railway/Render). "false" bila langsung.
TRUST_PROXY=1
POSTGRES_PASSWORD=GANTI_PASSWORD_DB
